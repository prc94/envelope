PY=$(command -v python || command -v python3)
"$PY" - <<'PY'
import re
import subprocess

env = {}
for line in open("mongo.env"):
    line = line.strip()
    if line and "=" in line:
        k, v = line.split("=", 1)
        env[k] = v

customer = "<<customer>>"
script = (
    "db.getSiblingDB(%r).orders.aggregate("
    "[{$match:{customer:%r}},{$group:{_id:null,total:{$sum:'$amount_cents'}}}]"
    ").toArray()" % (env["MONGO_DB"], customer)
)
out = subprocess.run(
    [
        "mongosh", "--quiet", "--host", env["MONGO_HOST"], "--port", env["MONGO_PORT"],
        "-u", env["MONGO_USER"], "-p", env["MONGO_PASSWORD"],
        "--authenticationDatabase", env["MONGO_DB"], "--eval", script,
    ],
    capture_output=True, text=True, check=True,
)
match = re.search(r"total:\s*([\d.]+)", out.stdout)
print(f"{float(match.group(1)) / 100:.2f}")
PY
