PY=$(command -v python || command -v python3)
"$PY" - <<'PY'
import subprocess

env = {}
for line in open("redis.env"):
    line = line.strip()
    if line and "=" in line:
        k, v = line.split("=", 1)
        env[k] = v

base = [
    "redis-cli", "-h", env["REDIS_HOST"], "-p", env["REDIS_PORT"],
    "--user", env["REDIS_USER"], "-a", env["REDIS_PASSWORD"], "--no-auth-warning",
]
pattern = "<<key_prefix>>:session:*"
keys = subprocess.run(
    base + ["--scan", "--pattern", pattern], capture_output=True, text=True, check=True
).stdout.split()
count = 0
for key in keys:
    value = subprocess.run(base + ["GET", key], capture_output=True, text=True, check=True).stdout.strip()
    if value == "active":
        count += 1
print(count)
PY
